        "pool_error",
        0,
        0,
        0,
        { status: 0, countdown: 0 },
        {
          players: [],
          message: `Your bet must be at least 2 times the last bet value (${
            lastBetValue * 2
          }).`,
        }
      );
    }
    currentPlayer.bet_value += bet_value;
    await PoolPlayer.updateBetValue(roomId, currentPlayer, currentPlayer.bet_value);
    const totalBetValue = players.reduce((sum, p) => sum + p.bet_value, 0);
    broadcastToRoom(
      io,
      roomId,
      "pool_turn_response",
      10,
      2,
      totalBetValue,
      { status: 4, countdown: 0 },
      {
        players: players.map((p) => ({
          ...p,
          bet_value:
            p.user_id === userId ? currentPlayer.bet_value : p.bet_value,
          viewCardStatus:
            p.user_id === userId ? viewCardStatus : p.viewCardStatus,
        })),
      }
    );
    const currentPlayerIndex = players.findIndex((p) => p.user_id === userId);
    const nextPlayer = players[(currentPlayerIndex + 1) % players.length];
    await PoolPlayer.updateTurn(roomId, currentPlayer, false);
    await PoolPlayer.updateTurn(roomId, nextPlayer, true);
    const playerTurnOrder = [...players];
    manageTurn(
      nextPlayer,
      roomId,
      io,
      players,
      (currentPlayerIndex + 1) % players.length,
      playerTurnOrder,
      turnTimerRef
    );
  },
  handleViewCards: async (userId, roomId, io) => {
    const players = await PoolPlayer.getPlayersInRoom(roomId);
    const totalBetValue = players.reduce(
      (total, player) => total + player.bet_value,
      0
    );
    const currentPlayer = players.find((p) => p.user_id == userId);
    if (!currentPlayer) throw new Error("Player not found");
    currentPlayer.viewCardStatus = 1;
    await PoolPlayer.updateViewCardStatus(roomId, userId, 1);
    broadcastToRoom(
      io,
      roomId,
      "pool_view_cards_response",
      11,
      2,
      totalBetValue,
      { status: 4, countdown: 0 },
      {
        players: players.map((p) => ({
          ...p,
          viewCardStatus: p.user_id === userId ? 1 : p.viewCardStatus,
        })),
      }
    );
  },
	
	// next deals process 

	startNewPoolFromDeclare: async (roomId, io) => {
  const players = await PoolPlayer.getPlayersInRoom(roomId);
  const totalBetValue = players.reduce((total, p) => total + p.bet_value, 0);

  let finalDeck = [...cards];
  if (players.length === 4) finalDeck = [...cards, ...cards]; // 104 cards for 4 players

  for (let i = finalDeck.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [finalDeck[i], finalDeck[j]] = [finalDeck[j], finalDeck[i]];
  }

  const jokers = [];
  const randomJokerIndex = Math.floor(Math.random() * finalDeck.length);
  const jokerCard = finalDeck.splice(randomJokerIndex, 1)[0];
  jokers.push(jokerCard);
  const sameRankJokers = finalDeck.filter((c) => c.rank === jokerCard.rank);
  jokers.push(...sameRankJokers);

  const discardedCardIndex = Math.floor(Math.random() * finalDeck.length);
  const discardedCard = finalDeck.splice(discardedCardIndex, 1)[0];

  const playerHands = {};
  for (const player of players) {
    if (finalDeck.length >= 13) {
      const playerCards = finalDeck.splice(0, 13);
      playerHands[player.user_id] = playerCards;
      broadcastToRoom(
        io,
        roomId,
        "pool_game_card_distribution",
        7,
        2,
        totalBetValue,
        { status: 2, countdown: 0 },
        {
          players: [
            {
              id: player.id,
              game_card: { cards: playerCards },
            },
          ],
        }
      );
    }
  }

  gameStates.set(roomId, {
    finalDeck,
    discardedCards: [discardedCard],
    playerHands,
    jokers,
  });

  // Toss winner becomes first player (or use round winner)
  const tossWinner = players[0]; // Or pick using custom logic
  await PoolPlayer.updateTurn(roomId, tossWinner, true);

  await new Promise((resolve) => {
    let countdown = 5;
    const interval = setInterval(() => {
      broadcastToRoom(io, roomId, "pool_loading_timer", 15, 2, totalBetValue, {
        status: 3,
        countdown,
      });
      if (--countdown < 0) {
        clearInterval(interval);
        resolve();
      }
    }, 1000);
  });

  broadcastToRoom(
    io,
    roomId,
    "pool_joker_and_discarded",
    12,
    2,
    totalBetValue,
    { status: 2, countdown: 0 },
    {
      jokers,
      discardedCard,
      leftDeck: finalDeck,
      playerHands,
    }
  );

  const currentPlayerIndex = players.findIndex((p) => p.user_id === tossWinner.user_id);
  const turnTimerRef = PoolGameController.turnTimers[roomId] || { timer: null, interval: null };
  PoolGameController.turnTimers[roomId] = turnTimerRef;

  manageTurn(
    players[currentPlayerIndex],
    roomId,
    io,
    players,
    currentPlayerIndex,
    [...players],
    turnTimerRef
  );
}

