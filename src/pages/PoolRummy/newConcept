    if (!tossCard) throw new Error(`Invalid tossCardId: ${tossCardId}`);
    const shuffleDeck = () => {
      const deck = [...cards];
      for (let i = deck.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [deck[i], deck[j]] = [deck[j], deck[i]];
      }
      return deck;
