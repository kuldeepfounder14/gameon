const duration = 120;
const gameStates = new Map();
const playerDiscardStatus = new Map(); // Map<roomId, { [userId]: boolean }>
const cleanupGame = (roomId) => {
  const timers = PoolGameController.turnTimers[roomId];
  if (timers) {
    if (timers.timer) clearTimeout(timers.timer);
    if (timers.interval) clearInterval(timers.interval);
    delete PoolGameController.turnTimers[roomId];
  }
  gameStates.delete(roomId);
  playerDiscardStatus.delete(roomId);
};

const eliminateAndDeclareOpponentWinner = async (
  roomId,
  eliminatedPlayerId,
  io
) => {
  try {
    const players = await PoolPlayer.getPlayersInRoom(roomId);
    const eliminated = players.find((p) => p.user_id === eliminatedPlayerId);
    const remaining = players.find((p) => p.user_id !== eliminatedPlayerId);
    const gameState = gameStates.get(roomId);
    const { jokers, playerHands } = gameState || {};
    const cards = playerHands?.[eliminatedPlayerId];
    if (cards.length===0) {
      throw new Error("Eliminated player's cards not found in playerHands");
    }
    const result = analyzeHand(cards, jokers);
    const leftPoints = result?.leftPoints || 0;
    await PoolRoom.addToWallet(remaining.user_id, leftPoints+100);
    if (!eliminated || !remaining) throw new Error("Invalid player data");
    broadcastToRoom(io, roomId, "pool_eliminated", 100, 0, 0, {
      loserId: eliminated.user_id,
      winnerId: remaining.user_id,
      message: `eliminated due to not played its turn.`,
      jokers,
		leftPoints
    });
    return { gameFinished: true };
  } catch (error) {
    console.error("eliminateAndDeclareOpponentWinner error:", error);
  }
};
const manageTurn = async (
  currentPlayer,
  roomId,
  io,
  players,
  currentPlayerIndex,
  playerTurnOrder,
  turnTimerRef
) => {
  if (turnTimerRef.timer) clearTimeout(turnTimerRef.timer);
  if (turnTimerRef.interval) clearInterval(turnTimerRef.interval);
  let countdown = duration;
  const totalBetValue = players.reduce(
    (total, player) => total + player.bet_value,
    0
  );
  players.forEach((player, index) => {
    player.is_turn = index === currentPlayerIndex ? 1 : 0;
  });
  // Turn countdown broadcasting
  turnTimerRef.interval = setInterval(async () => {
    for (const player of players) {
      player.viewCardStatus = await PoolPlayer.getPlayerViewCardStatus(
        roomId,
        player.user_id
      );
    }
    const state = gameStates.get(roomId);
    if (!state) throw new Error("Game state not found");
    const { playerHands, jokers } = state;
    // console.log("currentPlayerIndex", currentPlayer);
    const results = {};
    for (const player of players) {
      const hand = playerHands[player.user_id];
      const result = analyzeHand(hand, jokers);
      results[player.user_id] = result;
      updateHandAnalysis(roomId, player.user_id, result);
    }
    broadcastToRoom(
      io,
      roomId,
      "pool_turn_started",
      9,
      2,
      totalBetValue,
      { status: 4, countdown },
      {
        players: players.map((player) => ({ ...player })),
        results,
      }
    );

    if (--countdown <= 0) {
      clearInterval(turnTimerRef.interval);
    }
  }, 1000);
  // ✅ Set discard flag to false at start of turn
  if (!playerDiscardStatus.has(roomId)) playerDiscardStatus.set(roomId, {});
  const discardStatus = playerDiscardStatus.get(roomId);
  discardStatus[currentPlayer.user_id] = false;

  // Move to next player when time is up or eliminate
  turnTimerRef.timer = setTimeout(async () => {
    const didDiscard = discardStatus[currentPlayer.user_id];
    if (!didDiscard) {
      // ✅ If player didn’t discard, eliminate as before
      await eliminateAndDeclareOpponentWinner(
        roomId,
        currentPlayer.user_id,
        io
      );
      cleanupGame(roomId);
      return;
    }

    // ✅ If discarded but isFinalDeclare === false, just move turn
    const gameState = gameStates.get(roomId);
    const isFinalDeclare =
      gameState?.isFinalDeclareMap?.[currentPlayer.user_id] || false;

    if (!isFinalDeclare) {
      // Move to next player
      const nextIndex = (currentPlayerIndex + 1) % players.length;
      const nextPlayer = playerTurnOrder[nextIndex];
      players.forEach((player, index) => {
        player.is_turn = index === nextIndex ? 1 : 0;
      });
      manageTurn(
        nextPlayer,
        roomId,
        io,
        players,
        nextIndex,
        playerTurnOrder,
        turnTimerRef
      );
      return;
    }

    // ✅ If isFinalDeclare === true, do nothing. The timeout in handleDiscardCard will handle the flow.

    const nextIndex = (currentPlayerIndex + 1) % players.length;
    const nextPlayer = playerTurnOrder[nextIndex];
    players.forEach((player, index) => {
      player.is_turn = index === nextIndex ? 1 : 0;
    });
    manageTurn(
      nextPlayer,
      roomId,
      io,
      players,
      nextIndex,
      playerTurnOrder,
      turnTimerRef
    );
  }, duration * 1000);
};
