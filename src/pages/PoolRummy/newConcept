      return broadcastToRoom(
        io,
        roomId,
        "pool_error",
        0,
        0,
        0,
        { status: 0, countdown: 0 },
        {
          players: [],
          message: "It's not your turn!",
        }
      );
    }
    const viewCardStatus = await PoolPlayer.getPlayerViewCardStatus(roomId, userId);
    const otherPlayers = players.filter((p) => p.user_id !== userId);
